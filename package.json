{
  "name": "omnicus",
  "version": "0.1.0",
  "private": true,
  "description": "Omnicus omnichannel automation platform monorepo",
  "packageManager": "pnpm@10.5.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm db:generate && turbo run build",
    "build:api": "pnpm db:generate && turbo run build --filter=@omnicus/api...",
    "build:web": "turbo run build --filter=@omnicus/web...",
    "build:worker": "pnpm db:generate && turbo run build --filter=@omnicus/worker...",
    "clean": "turbo run clean",
    "db:format": "pnpm --filter @omnicus/database db:format",
    "db:generate": "pnpm --filter @omnicus/database db:generate",
    "db:seed": "pnpm --filter @omnicus/database db:seed",
    "db:validate": "pnpm --filter @omnicus/database db:validate",
    "dev": "pnpm db:generate && turbo run dev",
    "dev:api": "pnpm db:generate && turbo run dev --filter=@omnicus/api...",
    "dev:web": "turbo run dev --filter=@omnicus/web...",
    "dev:worker": "pnpm db:generate && turbo run dev --filter=@omnicus/worker...",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "start:api": "pnpm --filter @omnicus/api start",
    "start:web": "pnpm --filter @omnicus/web start",
    "start:worker": "pnpm --filter @omnicus/worker start",
    "test": "turbo run test test:integration",
    "test:e2e": "playwright test",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json && turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "tsx": "4.23.1",
    "turbo": "2.10.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
