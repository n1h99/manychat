generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  engineType          = "client"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TokenStatus {
  ACTIVE
  ROTATED
  REVOKED
  REUSED
  EXPIRED
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
}

enum AutomationMode {
  ENABLED
  DISABLED
}

enum ChannelType {
  TELEGRAM
  WHATSAPP
  INSTAGRAM
  OTHER
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  SELECT
  MULTI_SELECT
  JSON
}
enum ChannelConnectionStatus {
  DRAFT
  ACTIVE
  DISABLED
  ERROR
}

enum RawWebhookEventStatus {
  RECEIVED
  EXPIRED
}

enum InboxRecordStatus {
  PENDING
  PROCESSING
  COMPLETED
  RETRY
  FAILED
  DEAD_LETTER
}

enum OutboxRecordStatus {
  PENDING
  PROCESSING
  RETRY
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum NormalizedEventType {
  MESSAGE
  COMMAND
  PHOTO
  DOCUMENT
  CALLBACK_QUERY
  CHAT_MEMBER
  UNSUPPORTED
}

enum ConversationStatus {
  ACTIVE
  CLOSED
}

enum ChannelIdentityStatus {
  ACTIVE
  BLOCKED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  COMMAND
  PHOTO
  DOCUMENT
  CALLBACK_QUERY
  SYSTEM
  UNSUPPORTED
}

enum MessageStatus {
  QUEUED
  RECEIVED
  PROCESSING
  SENT
  FAILED
  UNKNOWN
}

model User {
  id                  String                   @id @default(uuid())
  email               String
  normalizedEmail     String                   @unique
  passwordHash        String
  firstName           String
  lastName            String
  status              UserStatus               @default(ACTIVE)
  lastLoginAt         DateTime?                @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  globalRoles         GlobalUserRole[]         @relation("GlobalUserRoleUser")
  globalRolesCreated  GlobalUserRole[]         @relation("GlobalUserRoleCreatedBy")
  memberships         ProjectMembership[]      @relation("ProjectMembershipUser")
  membershipsCreated  ProjectMembership[]      @relation("ProjectMembershipCreatedBy")
  globalInvitesSent   GlobalUserInviteToken[]  @relation("GlobalInviteInvitedBy")
  projectInvitesSent  ProjectUserInviteToken[] @relation("ProjectInviteInvitedBy")
  auditLogs           AuditLog[]               @relation("AuditActor")

  @@map("users")
}

model Session {
  id                  String      @id @default(uuid())
  userId              String
  tokenFamilyId       String
  refreshTokenHash    String      @unique
  csrfTokenHash       String
  status              TokenStatus @default(ACTIVE)
  replacedBySessionId String?
  issuedAt            DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt           DateTime    @db.Timestamptz(3)
  rotatedAt           DateTime?   @db.Timestamptz(3)
  revokedAt           DateTime?   @db.Timestamptz(3)
  reuseDetectedAt     DateTime?   @db.Timestamptz(3)
  ip                  String?
  userAgent           String?
  user                User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBySession   Session?    @relation("SessionRotation", fields: [replacedBySessionId, userId, tokenFamilyId], references: [id, userId, tokenFamilyId], onDelete: Restrict)
  replacesSession     Session?    @relation("SessionRotation")

  @@unique([id, userId, tokenFamilyId])
  @@unique([replacedBySessionId, userId, tokenFamilyId])
  @@index([userId, status])
  @@index([tokenFamilyId, status])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  ip        String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Permission {
  id           String                  @id @default(uuid())
  code         String                  @unique
  description  String
  globalRoles  GlobalRolePermission[]
  projectRoles ProjectRolePermission[]

  @@map("permissions")
}

model GlobalRole {
  id                       String                          @id @default(uuid())
  name                     String
  normalizedName           String                          @unique
  system                   Boolean                         @default(false)
  createdAt                DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                        @updatedAt @db.Timestamptz(3)
  permissions              GlobalRolePermission[]
  userRoles                GlobalUserRole[]
  inviteTokens             GlobalUserInviteToken[]
  activeInviteReservations GlobalActiveInviteReservation[]

  @@map("global_roles")
}

model ProjectRole {
  id             String                   @id @default(uuid())
  projectId      String
  name           String
  normalizedName String
  system         Boolean                  @default(false)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  permissions    ProjectRolePermission[]
  memberships    ProjectMembership[]
  inviteTokens   ProjectUserInviteToken[]

  @@unique([projectId, id])
  @@unique([projectId, normalizedName])
  @@map("project_roles")
}

model GlobalRolePermission {
  globalRoleId String
  permissionId String
  globalRole   GlobalRole @relation(fields: [globalRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([globalRoleId, permissionId])
  @@index([permissionId])
  @@map("global_role_permissions")
}

model ProjectRolePermission {
  projectId     String
  projectRoleId String
  permissionId  String
  projectRole   ProjectRole @relation(fields: [projectId, projectRoleId], references: [projectId, id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([projectId, projectRoleId, permissionId])
  @@index([permissionId])
  @@map("project_role_permissions")
}

model GlobalUserRole {
  id           String     @id @default(uuid())
  userId       String
  globalRoleId String
  createdById  String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  user         User       @relation("GlobalUserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  globalRole   GlobalRole @relation(fields: [globalRoleId], references: [id], onDelete: Restrict)
  createdBy    User?      @relation("GlobalUserRoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([userId, globalRoleId])
  @@index([globalRoleId])
  @@index([createdById])
  @@map("global_user_roles")
}

model ProjectMembership {
  id            String           @id @default(uuid())
  projectId     String
  userId        String
  projectRoleId String
  createdById   String?
  status        MembershipStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user          User             @relation("ProjectMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  projectRole   ProjectRole      @relation(fields: [projectId, projectRoleId], references: [projectId, id], onDelete: Restrict)
  createdBy     User?            @relation("ProjectMembershipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, id])
  @@unique([projectId, userId])
  @@index([projectId, projectRoleId])
  @@index([userId, status])
  @@index([createdById])
  @@map("project_memberships")
}

model GlobalUserInviteToken {
  id                     String                         @id @default(uuid())
  normalizedEmail        String
  emailSnapshot          String
  globalRoleId           String
  tokenHash              String                         @unique
  invitedById            String?
  invitedByEmailSnapshot String
  expiresAt              DateTime                       @db.Timestamptz(3)
  acceptedAt             DateTime?                      @db.Timestamptz(3)
  revokedAt              DateTime?                      @db.Timestamptz(3)
  createdAt              DateTime                       @default(now()) @db.Timestamptz(3)
  globalRole             GlobalRole                     @relation(fields: [globalRoleId], references: [id], onDelete: Restrict)
  invitedBy              User?                          @relation("GlobalInviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  activeReservation      GlobalActiveInviteReservation?

  @@unique([id, globalRoleId])
  @@index([normalizedEmail, expiresAt])
  @@index([globalRoleId])
  @@index([invitedById])
  @@map("global_user_invite_tokens")
}

model GlobalActiveInviteReservation {
  normalizedEmail String
  globalRoleId    String
  inviteTokenId   String                @unique
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  globalRole      GlobalRole            @relation(fields: [globalRoleId], references: [id], onDelete: Restrict)
  inviteToken     GlobalUserInviteToken @relation(fields: [inviteTokenId, globalRoleId], references: [id, globalRoleId], onDelete: Cascade)

  @@id([normalizedEmail, globalRoleId])
  @@unique([inviteTokenId, globalRoleId])
  @@index([globalRoleId])
  @@map("global_active_invite_reservations")
}

model ProjectUserInviteToken {
  id                     String                          @id @default(uuid())
  projectId              String
  projectRoleId          String
  normalizedEmail        String
  emailSnapshot          String
  tokenHash              String                          @unique
  invitedById            String?
  invitedByEmailSnapshot String
  expiresAt              DateTime                        @db.Timestamptz(3)
  acceptedAt             DateTime?                       @db.Timestamptz(3)
  revokedAt              DateTime?                       @db.Timestamptz(3)
  createdAt              DateTime                        @default(now()) @db.Timestamptz(3)
  project                Project                         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectRole            ProjectRole                     @relation(fields: [projectId, projectRoleId], references: [projectId, id], onDelete: Restrict)
  invitedBy              User?                           @relation("ProjectInviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  activeReservation      ProjectActiveInviteReservation?

  @@unique([projectId, id])
  @@index([projectId, normalizedEmail, expiresAt])
  @@index([projectId, projectRoleId])
  @@index([invitedById])
  @@map("project_user_invite_tokens")
}

model ProjectActiveInviteReservation {
  projectId       String
  normalizedEmail String
  inviteTokenId   String                 @unique
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  inviteToken     ProjectUserInviteToken @relation(fields: [projectId, inviteTokenId], references: [projectId, id], onDelete: Cascade)

  @@id([projectId, normalizedEmail])
  @@unique([projectId, inviteTokenId])
  @@map("project_active_invite_reservations")
}

model Project {
  id                       String                           @id @default(uuid())
  name                     String
  slug                     String                           @unique
  description              String?
  status                   ProjectStatus                    @default(DRAFT)
  timezone                 String
  locale                   String
  settings                 Json
  version                  Int                              @default(1)
  createdAt                DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                         @updatedAt @db.Timestamptz(3)
  roles                    ProjectRole[]
  memberships              ProjectMembership[]
  inviteTokens             ProjectUserInviteToken[]
  activeInviteReservations ProjectActiveInviteReservation[]
  auditLogs                AuditLog[]
  contacts                 Contact[]
  tags                     Tag[]
  customFieldDefinitions   CustomFieldDefinition[]
  channelConnections       ChannelConnection[]

  @@index([status, createdAt])
  @@map("projects")
}

model Contact {
  id                 String         @id @default(uuid())
  projectId          String
  displayName        String
  firstName          String?
  lastName           String?
  username           String?
  phone              String?
  email              String?
  status             ContactStatus  @default(ACTIVE)
  automationMode     AutomationMode @default(ENABLED)
  crmLeadId          String?
  crmContactId       String?
  crmManagerId       String?
  customFields       Json           @default("{}")
  firstInteractionAt DateTime?      @db.Timestamptz(3)
  lastInteractionAt  DateTime?      @db.Timestamptz(3)
  archivedAt         DateTime?      @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  channelIdentities  ChannelIdentity[]
  tags               ContactTag[]
  conversations      Conversation[]
  messages           Message[]

  @@unique([projectId, id])
  @@index([projectId, status, createdAt])
  @@index([projectId, lastInteractionAt])
  @@index([projectId, displayName])
  @@index([projectId, crmLeadId])
  @@map("contacts")
}

model ChannelIdentity {
  id             String                @id @default(uuid())
  projectId      String
  contactId      String
  connectionId   String
  channel        ChannelType
  externalUserId String
  username       String?
  displayName    String?
  languageCode   String?
  status         ChannelIdentityStatus @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  contact        Contact               @relation(fields: [projectId, contactId], references: [projectId, id], onDelete: Cascade)
  connection     ChannelConnection     @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Restrict)

  @@unique([projectId, id])
  @@unique([projectId, connectionId, externalUserId])
  @@index([projectId, contactId])
  @@map("channel_identities")
}

model ChannelConnection {
  id                     String                  @id @default(uuid())
  projectId              String
  type                   ChannelType             @default(TELEGRAM)
  status                 ChannelConnectionStatus @default(DRAFT)
  credentialsEncrypted   Json
  webhookSecretEncrypted Json
  botUsername            String?
  externalBotId          String?
  webhookMetadata        Json?
  lastWebhookAt          DateTime?               @db.Timestamptz(3)
  lastErrorAt            DateTime?               @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  identities             ChannelIdentity[]
  rawWebhookEvents       RawWebhookEvent[]
  inboxRecords           InboxRecord[]
  normalizedEvents       NormalizedEvent[]
  conversations          Conversation[]
  messages               Message[]
  outboxRecords          OutboxRecord[]

  @@unique([projectId, id])
  @@index([projectId, status])
  @@index([projectId, type])
  @@map("channel_connections")
}

model RawWebhookEvent {
  id               String                @id @default(uuid())
  projectId        String
  connectionId     String
  externalUpdateId String
  status           RawWebhookEventStatus @default(RECEIVED)
  payload          Json
  correlationId    String
  receivedAt       DateTime              @default(now()) @db.Timestamptz(3)
  purgeAfter       DateTime              @db.Timestamptz(3)
  connection       ChannelConnection     @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Restrict)
  inboxRecord      InboxRecord?

  @@unique([projectId, id])
  @@unique([connectionId, externalUpdateId])
  @@index([projectId, connectionId, receivedAt])
  @@index([projectId, correlationId])
  @@index([projectId, purgeAfter])
  @@map("raw_webhook_events")
}

model InboxRecord {
  id                String            @id @default(uuid())
  projectId         String
  connectionId      String
  rawWebhookEventId String            @unique
  status            InboxRecordStatus @default(PENDING)
  attempts          Int               @default(0)
  maxAttempts       Int               @default(8)
  nextAttemptAt     DateTime?         @db.Timestamptz(3)
  lockedAt          DateTime?         @db.Timestamptz(3)
  lockedBy          String?
  lastError         String?
  completedAt       DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  connection        ChannelConnection @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Restrict)
  rawWebhookEvent   RawWebhookEvent   @relation(fields: [projectId, rawWebhookEventId], references: [projectId, id], onDelete: Restrict)
  normalizedEvent   NormalizedEvent?

  @@unique([projectId, id])
  @@unique([projectId, rawWebhookEventId])
  @@index([status, nextAttemptAt])
  @@index([projectId, connectionId, status])
  @@map("inbox_records")
}

model NormalizedEvent {
  id            String              @id @default(uuid())
  projectId     String
  connectionId  String
  inboxRecordId String              @unique
  type          NormalizedEventType
  payload       Json
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  connection    ChannelConnection   @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Restrict)
  inboxRecord   InboxRecord         @relation(fields: [projectId, inboxRecordId], references: [projectId, id], onDelete: Restrict)
  message       Message?

  @@unique([projectId, id])
  @@unique([projectId, inboxRecordId])
  @@index([projectId, connectionId, createdAt])
  @@map("normalized_events")
}

model Conversation {
  id             String             @id @default(uuid())
  projectId      String
  connectionId   String
  contactId      String
  externalChatId String
  status         ConversationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  contact        Contact            @relation(fields: [projectId, contactId], references: [projectId, id], onDelete: Restrict)
  connection     ChannelConnection  @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Restrict)
  messages       Message[]

  @@unique([projectId, id])
  @@unique([projectId, connectionId, externalChatId])
  @@index([projectId, connectionId, status])
  @@index([projectId, contactId, updatedAt])
  @@map("conversations")
}

model Message {
  id                String           @id @default(uuid())
  projectId         String
  connectionId      String
  conversationId    String
  contactId         String
  normalizedEventId String?
  direction         MessageDirection
  type              MessageType
  status            MessageStatus
  externalMessageId String?
  content           Json
  metadata          Json?
  sentAt            DateTime?        @db.Timestamptz(3)
  failedAt          DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  contact           Contact          @relation(fields: [projectId, contactId], references: [projectId, id], onDelete: Restrict)
  connection        ChannelConnection @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Restrict)
  conversation      Conversation     @relation(fields: [projectId, conversationId], references: [projectId, id], onDelete: Restrict)
  normalizedEvent  NormalizedEvent?  @relation(fields: [projectId, normalizedEventId], references: [projectId, id], onDelete: Restrict)

  @@unique([projectId, id])
  @@unique([projectId, normalizedEventId])
  @@unique([connectionId, direction, externalMessageId])
  @@index([projectId, conversationId, createdAt])
  @@index([projectId, connectionId, externalMessageId])
  @@map("messages")
}

model OutboxRecord {
  id             String             @id @default(uuid())
  projectId      String
  connectionId   String
  idempotencyKey String
  status         OutboxRecordStatus @default(PENDING)
  payload        Json
  attempts       Int                @default(0)
  maxAttempts    Int                @default(8)
  nextAttemptAt  DateTime?          @db.Timestamptz(3)
  lockedAt       DateTime?          @db.Timestamptz(3)
  lockedBy       String?
  lastError      String?
  completedAt    DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  connection     ChannelConnection  @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Restrict)

  @@unique([projectId, id])
  @@unique([projectId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([projectId, connectionId, status])
  @@map("outbox_records")
}

model IdempotencyRecord {
  id        String   @id @default(uuid())
  projectId String
  scope     String
  key       String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime? @db.Timestamptz(3)

  @@unique([projectId, scope, key])
  @@index([projectId, expiresAt])
  @@map("idempotency_records")
}

model Tag {
  id             String       @id @default(uuid())
  projectId      String
  name           String
  normalizedName String
  color          String?
  description    String?
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  contacts       ContactTag[]

  @@unique([projectId, id])
  @@unique([projectId, normalizedName])
  @@index([projectId, archivedAt])
  @@map("tags")
}

model ContactTag {
  projectId String
  contactId String
  tagId     String
  source    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  contact   Contact  @relation(fields: [projectId, contactId], references: [projectId, id], onDelete: Cascade)
  tag       Tag      @relation(fields: [projectId, tagId], references: [projectId, id], onDelete: Restrict)

  @@id([projectId, contactId, tagId])
  @@index([projectId, tagId, contactId])
  @@map("contact_tags")
}

model CustomFieldDefinition {
  id          String          @id @default(uuid())
  projectId   String
  key         String
  name        String
  description String?
  type        CustomFieldType
  options     Json?
  archivedAt  DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, id])
  @@unique([projectId, key])
  @@index([projectId, archivedAt])
  @@map("custom_field_definitions")
}

model AuditLog {
  id                  String   @id @default(uuid())
  projectId           String?
  projectNameSnapshot String?
  projectSlugSnapshot String?
  actorUserId         String?
  actorEmailSnapshot  String?
  actorType           String
  action              String
  entityType          String
  entityId            String?
  beforeSafeJson      Json?
  afterSafeJson       Json?
  ip                  String?
  userAgent           String?
  correlationId       String
  reason              String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  purgeAfter          DateTime @db.Timestamptz(3)
  project             Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor               User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([correlationId])
  @@index([purgeAfter])
  @@map("audit_logs")
}
