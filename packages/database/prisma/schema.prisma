generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  engineType          = "client"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TokenStatus {
  ACTIVE
  ROTATED
  REVOKED
  REUSED
  EXPIRED
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model User {
  id                  String                   @id @default(uuid())
  email               String
  normalizedEmail     String                   @unique
  passwordHash        String
  firstName           String
  lastName            String
  status              UserStatus               @default(ACTIVE)
  lastLoginAt         DateTime?                @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  globalRoles         GlobalUserRole[]         @relation("GlobalUserRoleUser")
  globalRolesCreated  GlobalUserRole[]         @relation("GlobalUserRoleCreatedBy")
  memberships         ProjectMembership[]      @relation("ProjectMembershipUser")
  membershipsCreated  ProjectMembership[]      @relation("ProjectMembershipCreatedBy")
  globalInvitesSent   GlobalUserInviteToken[]  @relation("GlobalInviteInvitedBy")
  projectInvitesSent  ProjectUserInviteToken[] @relation("ProjectInviteInvitedBy")
  auditLogs           AuditLog[]               @relation("AuditActor")

  @@map("users")
}

model Session {
  id                  String      @id @default(uuid())
  userId              String
  tokenFamilyId       String
  refreshTokenHash    String      @unique
  csrfTokenHash       String
  status              TokenStatus @default(ACTIVE)
  replacedBySessionId String?
  issuedAt            DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt           DateTime    @db.Timestamptz(3)
  rotatedAt           DateTime?   @db.Timestamptz(3)
  revokedAt           DateTime?   @db.Timestamptz(3)
  reuseDetectedAt     DateTime?   @db.Timestamptz(3)
  ip                  String?
  userAgent           String?
  user                User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBySession   Session?    @relation("SessionRotation", fields: [replacedBySessionId, userId, tokenFamilyId], references: [id, userId, tokenFamilyId], onDelete: Restrict)
  replacesSession     Session?    @relation("SessionRotation")

  @@unique([id, userId, tokenFamilyId])
  @@unique([replacedBySessionId, userId, tokenFamilyId])
  @@index([userId, status])
  @@index([tokenFamilyId, status])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  ip        String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Permission {
  id           String                  @id @default(uuid())
  code         String                  @unique
  description  String
  globalRoles  GlobalRolePermission[]
  projectRoles ProjectRolePermission[]

  @@map("permissions")
}

model GlobalRole {
  id             String                  @id @default(uuid())
  name           String
  normalizedName String                  @unique
  system         Boolean                 @default(false)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)
  permissions    GlobalRolePermission[]
  userRoles      GlobalUserRole[]
  inviteTokens   GlobalUserInviteToken[]

  @@map("global_roles")
}

model ProjectRole {
  id             String                   @id @default(uuid())
  projectId      String
  name           String
  normalizedName String
  system         Boolean                  @default(false)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  permissions    ProjectRolePermission[]
  memberships    ProjectMembership[]
  inviteTokens   ProjectUserInviteToken[]

  @@unique([projectId, id])
  @@unique([projectId, normalizedName])
  @@map("project_roles")
}

model GlobalRolePermission {
  globalRoleId String
  permissionId String
  globalRole   GlobalRole @relation(fields: [globalRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([globalRoleId, permissionId])
  @@index([permissionId])
  @@map("global_role_permissions")
}

model ProjectRolePermission {
  projectId     String
  projectRoleId String
  permissionId  String
  projectRole   ProjectRole @relation(fields: [projectId, projectRoleId], references: [projectId, id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([projectId, projectRoleId, permissionId])
  @@index([permissionId])
  @@map("project_role_permissions")
}

model GlobalUserRole {
  id           String     @id @default(uuid())
  userId       String
  globalRoleId String
  createdById  String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  user         User       @relation("GlobalUserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  globalRole   GlobalRole @relation(fields: [globalRoleId], references: [id], onDelete: Restrict)
  createdBy    User?      @relation("GlobalUserRoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([userId, globalRoleId])
  @@index([globalRoleId])
  @@index([createdById])
  @@map("global_user_roles")
}

model ProjectMembership {
  id            String           @id @default(uuid())
  projectId     String
  userId        String
  projectRoleId String
  createdById   String?
  status        MembershipStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user          User             @relation("ProjectMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  projectRole   ProjectRole      @relation(fields: [projectId, projectRoleId], references: [projectId, id], onDelete: Restrict)
  createdBy     User?            @relation("ProjectMembershipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, id])
  @@unique([projectId, userId])
  @@index([projectId, projectRoleId])
  @@index([userId, status])
  @@index([createdById])
  @@map("project_memberships")
}

model GlobalUserInviteToken {
  id                     String     @id @default(uuid())
  normalizedEmail        String
  emailSnapshot          String
  globalRoleId           String
  tokenHash              String     @unique
  invitedById            String?
  invitedByEmailSnapshot String
  expiresAt              DateTime   @db.Timestamptz(3)
  acceptedAt             DateTime?  @db.Timestamptz(3)
  revokedAt              DateTime?  @db.Timestamptz(3)
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)
  globalRole             GlobalRole @relation(fields: [globalRoleId], references: [id], onDelete: Restrict)
  invitedBy              User?      @relation("GlobalInviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([normalizedEmail, globalRoleId], map: "global_invites_active_email_role_key", where: raw("\"acceptedAt\" IS NULL AND \"revokedAt\" IS NULL"))
  @@index([normalizedEmail, expiresAt])
  @@index([globalRoleId])
  @@index([invitedById])
  @@map("global_user_invite_tokens")
}

model ProjectUserInviteToken {
  id                     String      @id @default(uuid())
  projectId              String
  projectRoleId          String
  normalizedEmail        String
  emailSnapshot          String
  tokenHash              String      @unique
  invitedById            String?
  invitedByEmailSnapshot String
  expiresAt              DateTime    @db.Timestamptz(3)
  acceptedAt             DateTime?   @db.Timestamptz(3)
  revokedAt              DateTime?   @db.Timestamptz(3)
  createdAt              DateTime    @default(now()) @db.Timestamptz(3)
  project                Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectRole            ProjectRole @relation(fields: [projectId, projectRoleId], references: [projectId, id], onDelete: Restrict)
  invitedBy              User?       @relation("ProjectInviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([projectId, id])
  @@unique([projectId, normalizedEmail], map: "project_invites_active_email_key", where: raw("\"acceptedAt\" IS NULL AND \"revokedAt\" IS NULL"))
  @@index([projectId, normalizedEmail, expiresAt])
  @@index([projectId, projectRoleId])
  @@index([invitedById])
  @@map("project_user_invite_tokens")
}

model Project {
  id           String                   @id @default(uuid())
  name         String
  slug         String                   @unique
  description  String?
  status       ProjectStatus            @default(DRAFT)
  timezone     String
  locale       String
  settings     Json
  version      Int                      @default(1)
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @db.Timestamptz(3)
  roles        ProjectRole[]
  memberships  ProjectMembership[]
  inviteTokens ProjectUserInviteToken[]
  auditLogs    AuditLog[]

  @@index([status, createdAt])
  @@map("projects")
}

model AuditLog {
  id                  String   @id @default(uuid())
  projectId           String?
  projectNameSnapshot String?
  projectSlugSnapshot String?
  actorUserId         String?
  actorEmailSnapshot  String?
  actorType           String
  action              String
  entityType          String
  entityId            String?
  beforeSafeJson      Json?
  afterSafeJson       Json?
  ip                  String?
  userAgent           String?
  correlationId       String
  reason              String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  purgeAfter          DateTime @db.Timestamptz(3)
  project             Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor               User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([correlationId])
  @@index([purgeAfter])
  @@map("audit_logs")
}
