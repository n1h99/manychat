{
  "name": "@omnicus/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-output.mjs packages/database/dist && tsc -p tsconfig.build.json",
    "db:seed": "node ../../scripts/run-prisma.mjs generate --config prisma.config.ts && node ../../scripts/pnpm.mjs --filter @omnicus/database build && node dist/seed.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "dotenv": "17.4.2",
    "prisma": "7.9.0"
  }
}
