# Shared server environment (APP_ENV and NODE_ENV are always explicit)
NODE_ENV=development
APP_ENV=development
DATABASE_URL=postgresql://omnicus:omnicus@localhost:5433/omnicus?schema=public
REDIS_URL=redis://localhost:6379/0
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
CHANNEL_SECRETS_KEY=replace-with-base64-of-a-random-32-byte-key
JWT_BROWSER_SESSION_TTL_SECONDS=604800
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# API
API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
TRUST_PROXY=loopback,linklocal,uniquelocal

# Worker (use these values in the worker service environment)
WORKER_HOST=0.0.0.0
WORKER_PORT=3001
BULLMQ_READY_TIMEOUT_MS=5000
WORKER_SHUTDOWN_TIMEOUT_MS=10000
DEMO_JOB_ENABLED=false
AUTOMATION_CONTINUATION_INTERVAL_MS=10000
AUTOMATION_CONTINUATION_BATCH_SIZE=100

# Private S3-compatible media storage. Railway variable references should map
# BUCKET/ACCESS_KEY_ID/SECRET_ACCESS_KEY/REGION/ENDPOINT to these names.
MEDIA_STORAGE_ENABLED=false
MEDIA_BUCKET=
MEDIA_BUCKET_ACCESS_KEY_ID=
MEDIA_BUCKET_SECRET_ACCESS_KEY=
MEDIA_BUCKET_REGION=auto
MEDIA_BUCKET_ENDPOINT=https://storage.railway.app
MEDIA_BUCKET_FORCE_PATH_STYLE=false
MEDIA_MAX_UPLOAD_BYTES=20971520
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_RETENTION_DAYS=30
MEDIA_RETENTION_INTERVAL_MS=60000
MEDIA_RETENTION_BATCH_SIZE=100

# Web (embedded at build time)
VITE_API_URL=http://localhost:3000

# Destructive-command guards (development/test Stage 1 seed only)
ALLOW_DATABASE_SEED=false
ALLOW_SYSTEM_ROLE_BACKFILL=false
ALLOW_REMOTE_DATABASE_SEED=false
SEED_DATABASE_NAME_CONFIRMATION=omnicus
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
