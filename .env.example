# Shared server environment (APP_ENV and NODE_ENV are always explicit)
NODE_ENV=development
APP_ENV=development
DATABASE_URL=postgresql://omnicus:omnicus@localhost:5432/omnicus?schema=public
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
TRUST_PROXY=loopback,linklocal,uniquelocal

# Worker (use these values in the worker service environment)
WORKER_HOST=0.0.0.0
WORKER_PORT=3001
BULLMQ_READY_TIMEOUT_MS=5000
WORKER_SHUTDOWN_TIMEOUT_MS=10000
DEMO_JOB_ENABLED=false

# Web (embedded at build time)
VITE_API_URL=http://localhost:3000

# Destructive-command guards (seed creates no business rows in Stage 0)
ALLOW_DATABASE_SEED=false
ALLOW_REMOTE_DATABASE_SEED=false
SEED_DATABASE_NAME_CONFIRMATION=omnicus
