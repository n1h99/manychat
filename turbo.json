{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["OMNICUS_TOOLCHAIN_NODE_VERSION"],
  "globalPassThroughEnv": ["OMNICUS_NODE_EXECUTABLE", "OMNICUS_PNPM_EXECUTABLE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_API_URL"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
